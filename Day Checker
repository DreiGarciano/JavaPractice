package scherry;
import java.util.Scanner;
public class Scherry {
    
    public static String getDay(int dayCheck) {
        switch(dayCheck) {
            case 1: 
            case 2: 
            case 3:
            case 4:       
            case 5:
                return "Weekday";
            case 6:
            case 7:
                return "Weekend";
            default: 
                return "Invalid Input";
        }
    }
    
    public static void main(String[] args) {
      Scanner input = new Scanner(System.in);
      int day = 0;
      
        System.out.println("Enter day: ");
        day = input.nextInt();
        
        System.out.println(getDay(day));
    }   
}
