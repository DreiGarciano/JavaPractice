private void jButton1ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        try {  
          double java = Double.parseDouble(txtJava.getText()); // txtJava = variable name nung textbox
          double database = Double.parseDouble(txtDatabase.getText()); // txtDatabase same lang din 
          double networking = Double.parseDouble(txtNetworking.getText()); // txtNetworking same lang din 
          double math = Double.parseDouble(txtMath.getText()); // txtMath same lang din 
          
          double total = java + database + networking + math;
          double average = total / 4;
          
          double highest = Math.max(Math.max(java, database), Math.max(networking, math));
          double lowest = Math.min(Math.min(java, database), Math.min(networking, math));
          
          String result = (average >= 75) ? "PASSED" : "FAILED";
          
         txtTotal.setText(String.valueOf(total));
         txtAverage.setText(String.format("%.2f", average));
         txtHighest.setText(String.valueOf(highest));
         txtLowest.setText(String.valueOf(lowest));
         txtResult.setText(result);
        } 
        catch (NumberFormatException e) {
        javax.swing.JOptionPane.showMessageDialog(this,
            "bugok.",
            "Input Error",
            javax.swing.JOptionPane.ERROR_MESSAGE);
    }
    
    }                                        

