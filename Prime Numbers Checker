package scherry;
public class Scherry {
    public static boolean primeChecker(int num) {
        if(num <= 0) {
            return false;
        }
        for(int i = 2; i < num; i++) {
            if(num  % i == 0) {
                return false;
            }
        }
        return true;
}
    public static void main(String[] args) {
        System.out.println("10 is a prime number: " + primeChecker(10));
        System.out.println("7 is a prime number: " + primeChecker(7));
        System.out.println("4 is a prime number: " + primeChecker(4));
    }   
}
