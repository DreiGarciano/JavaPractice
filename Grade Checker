package scherry;
import java.util.Scanner;
public class Scherry {
    public static String gradeChecker(int grade) {
        if(grade >= 90) {
            return "A";
        }
        else if (grade <= 89 && grade >=80 ) {
            return "B";
        }
        else if(grade <= 79 && grade >= 70) {
            return "C";
        }
       else if(grade <= 69 && grade >= 60) {
            return "D";
        }
       else {
           return "F";
       }
    }
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int grade = 0;
        System.out.println("Enter Grade: ");
        grade = input.nextInt();
        
        System.out.println("Your grade is: " + gradeChecker(grade));
    }   
}
